@using WebApplication3.Enums
@model WebApplication3.ViewModels.TodoaddVm

@{
    ViewData["Title"] = "add";
}

<h1>add</h1>

<h4>TodoaddVm</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="add">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Libelle" class="control-label"></label>
                <input asp-for="Libelle" class="form-control" />
                <span asp-validation-for="Libelle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" ></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Datelimit" class="control-label"></label>
                <input asp-for="Datelimit" class="form-control" />
                <span asp-validation-for="Datelimit" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="State" class="control-label"></label>
                TODO<input type ="radio" value ="@(State.Todo)" asp-for="State" checked />
                DOING<input type="radio" value="@(State.doing)" asp-for="State" />
                DONE<input type="radio" value="@(State.Done)" asp-for="State" />
                <span asp-validation-for="State" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
